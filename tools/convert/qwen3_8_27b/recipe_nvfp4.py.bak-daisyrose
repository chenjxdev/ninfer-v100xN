# How a publisher stored a projection's quad in the checkpoint. An artifact
# NVFP4 projection is a byte passthrough when its source quad is NVFP4; a
# publisher that exported the layer as ModelOpt FP8 (DaisyRose exports every
# GDN layer that way) is dequantized and requantized to NVFP4 instead.
SOURCE_FORMAT_NVFP4 = "nvfp4"
SOURCE_FORMAT_FP8 = "fp8"

# ModelOpt quad field suffixes on each quantized Linear base name.
WEIGHT = "weight"              # U8 packed [N, K/2]
WEIGHT_SCALE = "weight_scale"  # F8_E4M3 [N, K/16]
WEIGHT_SCALE_2 = "weight_scale_2"  # F32 scalar multiplier (QAD omits it when 1.0)
INPUT_SCALE = "input_scale"    # F32 scalar


@dataclass(frozen=True, slots=True)
class RowRange:
    begin: int
    end: int

    @property
    def rows(self) -> int:
        return self.end - self.begin


@dataclass(frozen=True, slots=True)
class MatrixSource:
    name: str
    shape: tuple[int, int]

    def field(self, suffix: str) -> str:
        return f"{self.name}.{suffix}"


@dataclass(frozen=True, slots=True)
class MatrixPart:
    source: MatrixSource
    rows: tuple[RowRange, ...]

    @property
    def output_rows(self) -> int:
        return sum(item.rows for item in self.rows)


@dataclass(frozen=True, slots=True)
class Nvfp4WeightRecipe:
    object_name: str
    shape: tuple[int, int]
    parts: tuple[MatrixPart, ...]
    divisor_sources: tuple[MatrixSource, ...]
    #: The publisher's format for this projection's source quads.
    source_format: str = SOURCE_FORMAT_NVFP4


@dataclass(frozen=True, slots=True)
class InputDivisorRecipe:
    object_name: str
    sources: tuple[MatrixSource, ...]
    weight_names: tuple[str, ...]


@dataclass(frozen=True, slots=True)
class GroupedWeightRecipe:
    """A BF16 source matrix (or fused concatenation) for a grouped format.

    The persistent numeric format (W8G32, Q4G64 or Q6G64) belongs to the
    inventory spec, not to this recipe: the recipe only says which BF16 source
    rows fuse into the matrix that the grouped quantizer consumes.
    """

    object_name: str
    shape: tuple[int, int]
    parts: tuple[MatrixPart, ...]


def _source(name: str, n: int, k: int) -> MatrixSource:
    return MatrixSource(name, (n, k))


def _all(source: MatrixSource) -> MatrixPart:
    return MatrixPart(source, (RowRange(0, source.shape[0]),))


def _q_part(source: MatrixSource, gate: bool) -> MatrixPart:
    begin = 256 if gate else 0
    return MatrixPart(
        source,
        tuple(
            RowRange(head * 512 + begin, head * 512 + begin + 256)
            for head in range(24)
        ),
    )


def _attention_source_format() -> str:
    """The publisher's format for the full-attention quads."""

    return (
        SOURCE_FORMAT_FP8
        if source_profile.ACTIVE.fp8_full_attention
        else SOURCE_FORMAT_NVFP4
    )


def _gdn_source_format(layer: int) -> str:
    """The publisher's format for one GDN layer's quads.

    The artifact keeps ten GDN layers as FP8 objects (the production
    profile); a layer the publisher exported as FP8 but the artifact stores
    as NVFP4 is requantized from FP8.
    """

    if layer in source_profile.ACTIVE.fp8_gdn_layers:
        return SOURCE_FORMAT_FP8
    return SOURCE_FORMAT_NVFP4


def _build_matrix_recipes() -> tuple[
    tuple[Nvfp4WeightRecipe, ...],
    tuple[InputDivisorRecipe, ...],
    tuple[GroupedWeightRecipe, ...],
]:
    nvfp4_weights: list[Nvfp4WeightRecipe] = []
    input_divisors: list[InputDivisorRecipe] = []
    grouped_weights: list[GroupedWeightRecipe] = []

    for layer in range(64):
        source_prefix = f"model.language_model.layers.{layer}."
        object_prefix = f"text/layers/{layer}/"
        if layer in inventory.FULL_ATTENTION_LAYERS:
            query = _source(source_prefix + "self_attn.q_proj", 12288, 5120)
            key = _source(source_prefix + "self_attn.k_proj", 1024, 5120)
            value = _source(source_prefix + "self_attn.v_proj", 1024, 5120)
            output = _source(source_prefix + "self_attn.o_proj", 5120, 6144)
            parts = (
                _q_part(query, False),
                _all(key),
                _q_part(query, True),
                _all(value),
            )
            nvfp4_weights.append(
                Nvfp4WeightRecipe(
                    object_prefix + "attention/query_key_gate_value",
                    (14336, 5120),
                    parts,
                    (query, key, value),
                    _attention_source_format(),
                )
            )
            nvfp4_weights.append(
                Nvfp4WeightRecipe(
                    object_prefix + "attention/output",
                    output.shape,
                    (_all(output),),
                    (output,),
                    _attention_source_format(),
                )
            )
            input_divisors.append(
                InputDivisorRecipe(
                    object_prefix
                    + "attention/input_projection/input_scale_divisor",
                    (query, key, value),
                    (object_prefix + "attention/query_key_gate_value",),
                )
            )
            input_divisors.append(
                InputDivisorRecipe(
                    object_prefix
                    + "attention/output_projection/input_scale_divisor",
                    (output,),
                    (object_prefix + "attention/output",),
                )
            )
        else:
            query_key_value = _source(
                source_prefix + "linear_attn.in_proj_qkv", 10240, 5120
            )
            z = _source(source_prefix + "linear_attn.in_proj_z", 6144, 5120)
            output = _source(
                source_prefix + "linear_attn.out_proj", 5120, 6144
            )
            nvfp4_weights.append(
                Nvfp4WeightRecipe(
                    object_prefix + "gdn/query_key_value_z",
                    (16384, 5120),
                    (_all(query_key_value), _all(z)),
                    (query_key_value, z),
                    _gdn_source_format(layer),
                )
            )
            nvfp4_weights.append(
                Nvfp4WeightRecipe(
                    object_prefix + "gdn/output",
                    output.shape,
                    (_all(output),),
                    (output,),
                    _gdn_source_format(layer),
                )
            )
            input_divisors.append(
                InputDivisorRecipe(
                    object_prefix
                    + "gdn/input_projection/input_scale_divisor",
                    (query_key_value, z),
                    (object_prefix + "gdn/query_key_value_z",),
                )
            )
            input_divisors.append(
                InputDivisorRecipe(
                    object_prefix
                    + "gdn/output_projection/input_scale_divisor",
                    (output,),
                    (object_prefix + "gdn/output",),
                )
            )

        gate = _source(source_prefix + "mlp.gate_proj", 17408, 5120)
        up = _source(source_prefix + "mlp.up_proj", 17408, 5120)
        down = _source(source_prefix + "mlp.down_proj", 5120, 17408)
        nvfp4_weights.extend(
            (
                Nvfp4WeightRecipe(
                    object_prefix + "mlp/gate_up",
                    (34816, 5120),
                    (_all(gate), _all(up)),
                    (gate, up),
                ),
                Nvfp4WeightRecipe(
                    object_prefix + "mlp/down",
                    down.shape,
                    (_all(down),),
                    (down,),
                ),
            )
        )
        input_divisors.extend(
            (
                InputDivisorRecipe(
                    object_prefix
                    + "mlp/gate_up_projection/input_scale_divisor",
                    (gate, up),
                    (object_prefix + "mlp/gate_up",),
                ),
                InputDivisorRecipe(
                    object_prefix + "mlp/down_projection/input_scale_divisor",
                    (down,),
                    (object_prefix + "mlp/down",),
                ),
            )
        )

    # Vocabulary endpoints: grouped formats quantized from the excluded BF16 sources.
    output_head = _source("lm_head", 248320, 5120)
    grouped_weights.append(
        GroupedWeightRecipe("text/output_head", output_head.shape, (_all(output_head),))
    )
    embedding = _source(
        "model.language_model.embed_tokens", 248320, 5120
    )
    grouped_weights.append(
        GroupedWeightRecipe(
            "text/token_embedding", embedding.shape, (_all(embedding),)
        )
    )

    # MTP matrices: grouped formats from the excluded BF16 sources.
    mtp_layer = "mtp.layers.0."
    mtp_q = _source(mtp_layer + "self_attn.q_proj", 12288, 5120)
    grouped_weights.extend(
        (
            GroupedWeightRecipe(
                "mtp/input_projection",
                (5120, 10240),
                (_all(_source("mtp.fc", 5120, 10240)),),
            ),
            GroupedWeightRecipe(
                "mtp/layer/attention/query_key_gate_value",
                (14336, 5120),
                (
                    _q_part(mtp_q, False),
                    _all(_source(mtp_layer + "self_attn.k_proj", 1024, 5120)),
                    _q_part(mtp_q, True),
                    _all(_source(mtp_layer + "self_attn.v_proj", 1024, 5120)),
                ),
            ),
            GroupedWeightRecipe(
                "mtp/layer/attention/output",
                (5120, 6144),
                (_all(_source(mtp_layer + "self_attn.o_proj", 5120, 6144)),),
            ),
            GroupedWeightRecipe(
                "mtp/layer/mlp/gate_up",
                (34816, 5120),
                (
                    _all(_source(mtp_layer + "mlp.gate_proj", 17408, 5120)),
                    _all(_source(mtp_layer + "mlp.up_proj", 17408, 5120)),
                ),
            ),
            GroupedWeightRecipe(
                "mtp/layer/mlp/down",
                (5120, 17408),
                (_all(_source(mtp_layer + "mlp.down_proj", 5120, 17408)),),
            ),
        )
    )
    return (
        tuple(nvfp4_weights),
        tuple(input_divisors),
        tuple(grouped_weights),
    )


def _build_direct_recipes() -> tuple[family_recipe.TensorRecipe, ...]:
    recipes: list[family_recipe.TensorRecipe] = []
    for layer in range(64):
        source_prefix = f"model.language_model.layers.{layer}."
        object_prefix = f"text/layers/{layer}/"
        recipes.append(
            family_recipe.TensorRecipe(
                object_prefix + "input_norm",
                family_recipe.source(
                    source_prefix + "input_layernorm.weight", (5120,)
                ),
            )
        )
        if layer in inventory.FULL_ATTENTION_LAYERS:
            recipes.extend(
                (
                    family_recipe.TensorRecipe(
                        object_prefix + "attention/query_norm",
                        family_recipe.source(
                            source_prefix + "self_attn.q_norm.weight", (256,)
                        ),
                    ),
                    family_recipe.TensorRecipe(
                        object_prefix + "attention/key_norm",
                        family_recipe.source(
                            source_prefix + "self_attn.k_norm.weight", (256,)
                        ),
                    ),
                )
            )
        else:
            convolution = family_recipe.source(
                source_prefix + "linear_attn.conv1d.weight", (10240, 1, 4)
            )
            recipes.extend(
                (
                    family_recipe.TensorRecipe(
                        object_prefix + "gdn/a_log",
                        family_recipe.Cast(
                            family_recipe.source(
                                source_prefix + "linear_attn.A_log", (48,)
                            ),
                            inventory.FP32,
                        ),
                    ),
                    family_recipe.TensorRecipe(
                        object_prefix + "gdn/dt_bias",
                        family_recipe.Cast(
                            family_recipe.source(
                                source_prefix + "linear_attn.dt_bias", (48,)
                            ),
                            inventory.FP32,
                        ),
                    ),
                    family_recipe.TensorRecipe(
                        object_prefix + "gdn/convolution",
                        family_recipe.Transpose(
                            family_recipe.Reshape(
                                family_recipe.Slice(convolution, 1, 0, 1),
                                (10240, 4),
                            ),
                            (1, 0),
                        ),
                    ),
                    family_recipe.TensorRecipe(
                        object_prefix + "gdn/a_b_projection",
                        family_recipe.Concat(
                            (
                                family_recipe.source(
                                    source_prefix
                                    + "linear_attn.in_proj_a.weight",
                                    (48, 5120),
                                ),
                                family_recipe.source(
                                    source_prefix
                                    + "linear_attn.in_proj_b.weight",
                                    (48, 5120),
                                ),
                            ),
                            0,
                        ),
                    ),
                    family_recipe.TensorRecipe(
                        object_prefix + "gdn/norm",
                        family_recipe.source(
                            source_prefix + "linear_attn.norm.weight", (128,)
                        ),
                    ),
                )
            )
        recipes.append(
            family_recipe.TensorRecipe(
                object_prefix + "post_attention_norm",
                family_recipe.source(
                    source_prefix + "post_attention_layernorm.weight", (5120,)
                ),
            )
        )
    recipes.append(
        family_recipe.TensorRecipe(
            "text/final_norm",
            family_recipe.source("model.language_model.norm.weight", (5120,)),
        )
    )
    return tuple(recipes)


